<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>精灵详情 · 洛克王国攻略站</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background-color: #1a1a2e; color: #e0e0e0;
        }
        a { text-decoration:none; color:#0ef; }

        .navbar {
            display:flex; justify-content:space-between; align-items:center;
            padding:1rem 5%; background-color:#16213e;
            position:sticky; top:0; z-index:100;
        }
        .logo { font-size:1.8rem; font-weight:bold; color:#0ef; }
        .logo span { color:#e94560; }
        .nav-links { display:flex; gap:2rem; }
        .nav-links a { color:#e0e0e0; font-weight:500; }
        .nav-links a:hover { color:#0ef; }

        .container { max-width:900px; margin:2rem auto; padding:0 1rem; }

        .back-link {
            display:inline-block; margin-bottom:1.5rem; color:#aaa;
            transition:color 0.3s;
        }
        .back-link:hover { color:#0ef; }

        .detail-card {
            background-color:#16213e; border-radius:16px;
            padding:2rem; border:1px solid #0f3460;
        }
        .pokemon-header {
            display:flex; align-items:center; gap:1.5rem; margin-bottom:1.5rem;
        }
        .pokemon-id { font-size:1.2rem; color:#aaa; }
        .pokemon-name { font-size:2.5rem; font-weight:bold; }
        .type-badges { display:flex; gap:0.5rem; margin-top:0.3rem; }
        .type-badge {
            padding:0.2rem 1rem; border-radius:20px; font-size:0.9rem;
            font-weight:bold;
        }
        .type-火 { background:#e94560; }
        .type-水 { background:#0f83e9; }
        .type-草 { background:#26de81; }
        .type-恶 { background:#2d3436; }
        .type-翼 { background:#a29bfe; }
        .type-龙 { background:#6c5ce7; }
        .type-电 { background:#fdcb6e; }
        .type-冰 { background:#74b9ff; }
        .type-格斗 { background:#e17055; }
        .type-毒 { background:#9b59b6; }
        .type-地面 { background:#cc8e35; }
        .type-岩石 { background:#b2bec3; }
        .type-虫 { background:#6ab04c; }
        .type-幽灵 { background:#636e72; }
        .type-钢 { background:#7f8c8d; }
        .type-一般 { background:#b2bec3; }

        .section {
            margin:1.5rem 0;
            border-top:1px solid #0f3460;
            padding-top:1.5rem;
        }
        .section h3 {
            font-size:1.3rem; margin-bottom:0.8rem;
            border-left:4px solid #0ef; padding-left:0.8rem;
        }

        .race-grid {
            display:grid; grid-template-columns:repeat(3, 1fr);
            gap:0.8rem; max-width:400px;
        }
        .race-item {
            background-color:#1a1a2e; padding:0.8rem;
            border-radius:8px; text-align:center;
        }
        .race-value { font-size:1.5rem; font-weight:bold; color:#0ef; }
        .race-label { font-size:0.8rem; color:#888; }
        .total-race {
            font-size:1.2rem; color:#e94560; margin-top:0.5rem;
        }

        .evolution-chain {
            display:flex; align-items:center; gap:1rem;
            flex-wrap:wrap;
        }
        .evo-stage {
            background-color:#1a1a2e; padding:1rem 1.5rem;
            border-radius:8px; text-align:center;
        }
        .evo-arrow { color:#0ef; font-size:1.5rem; }

        .skill-list {
            display:flex; flex-wrap:wrap; gap:0.5rem;
        }
        .skill-tag {
            background-color:#1a1a2e; padding:0.4rem 1rem;
            border-radius:20px; font-size:0.9rem; border:1px solid #0f3460;
        }

        .catch-info { color:#aaa; line-height:1.6; }
        .description { font-style:italic; color:#ccc; margin-top:0.5rem; }

        .footer {
            text-align:center; padding:2rem; background-color:#16213e;
            margin-top:3rem; color:#888;
        }
        @media (max-width:600px) {
            .pokemon-header { flex-direction:column; text-align:center; }
            .race-grid { grid-template-columns:repeat(2,1fr); }
        }
    </style>
    <!-- 引用公共数据 -->
    <script src="data.js"></script>
</head>
<body>

    <nav class="navbar">
        <div class="logo">洛克<span>攻略站</span></div>
        <div class="nav-links">
            <a href="index.html">首页</a>
            <a href="pokedex.html">精灵图鉴</a>
            <a href="teams.html">阵容推荐</a>
            <a href="map.html">资源地图</a>
        </div>
    </nav>

    <div class="container">
        <a href="pokedex.html" class="back-link">← 返回图鉴</a>
        <div class="detail-card" id="detailCard">
            <!-- 动态填充 -->
        </div>
    </div>

    <footer class="footer">
        <p>© 2026 洛克王国：世界玩家攻略站</p>
    </footer>

    <script>
        // 获取URL参数id
        const urlParams = new URLSearchParams(window.location.search);
        const id = parseInt(urlParams.get('id'));
        const pokemon = pokemonData.find(p => p.id === id);

        function renderDetail(p) {
            const card = document.getElementById('detailCard');
            if (!p) {
                card.innerHTML = '<h2>未找到该精灵</h2><p>请返回图鉴重新选择。</p>';
                return;
            }

            document.title = `${p.name} · 精灵详情`;

            let evoHtml = '';
            if (p.evolution) {
                if (p.evolution.prev) {
                    evoHtml = `
                        <div class="evolution-chain">
                            <div class="evo-stage">${p.evolution.prev}</div>
                            <div class="evo-arrow">→</div>
                            <div class="evo-stage"><strong>${p.name}</strong><br><small>当前</small></div>
                        </div>
                        <p style="color:#aaa; margin-top:0.5rem;">进化方式：${p.evolution.method}</p>
                    `;
                } else if (p.evolution.next) {
                    evoHtml = `
                        <div class="evolution-chain">
                            <div class="evo-stage"><strong>${p.name}</strong><br><small>当前</small></div>
                            <div class="evo-arrow">→</div>
                            <div class="evo-stage">${p.evolution.next}</div>
                        </div>
                        <p style="color:#aaa; margin-top:0.5rem;">进化方式：${p.evolution.method}</p>
                    `;
                }
            } else {
                evoHtml = '<p>无进化链信息</p>';
            }

            card.innerHTML = `
                <div class="pokemon-header">
                    <div>
                        <span class="pokemon-id">No.${p.number}</span>
                        <div class="pokemon-name">${p.name}</div>
                        <div class="type-badges">
                            ${p.type.map(t => `<span class="type-badge type-${t}">${t}</span>`).join('')}
                        </div>
                    </div>
                </div>
                <p class="description">${p.description}</p>

                <div class="section">
                    <h3>📊 种族值</h3>
                    <div class="race-grid">
                        <div class="race-item"><div class="race-value">${p.race.hp}</div><div class="race-label">HP</div></div>
                        <div class="race-item"><div class="race-value">${p.race.atk}</div><div class="race-label">攻击</div></div>
                        <div class="race-item"><div class="race-value">${p.race.def}</div><div class="race-label">防御</div></div>
                        <div class="race-item"><div class="race-value">${p.race.spa}</div><div class="race-label">特攻</div></div>
                        <div class="race-item"><div class="race-value">${p.race.spd}</div><div class="race-label">特防</div></div>
                        <div class="race-item"><div class="race-value">${p.race.spe}</div><div class="race-label">速度</div></div>
                    </div>
                    <div class="total-race">总和：${p.total}</div>
                </div>

                <div class="section">
                    <h3>⚡ 技能池</h3>
                    <div class="skill-list">
                        ${p.skills.map(s => `<span class="skill-tag">${s}</span>`).join('')}
                    </div>
                </div>

                <div class="section">
                    <h3>🔄 进化链</h3>
                    ${evoHtml}
                </div>

                <div class="section">
                    <h3>📍 捕获信息</h3>
                    <p class="catch-info">${p.catch}</p>
                </div>

                <div class="section">
                    <h3>📖 关联攻略（即将上线）</h3>
                    <p style="color:#888;">配队建议、培养路线等内容筹备中...</p>
                </div>
            `;
        }

        renderDetail(pokemon);
    </script>
</body>
</html>
